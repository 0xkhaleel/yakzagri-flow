# Application environment. One of: development | testnet | production
# Production builds MUST set this to "production" and provide real credentials below.
NEXT_PUBLIC_APP_ENV=development

# Stellar network passphrase used by the app.
# Leave unset in development to fall back to the TESTNET passphrase.
# In production this MUST be set to the PUBLIC network passphrase.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# Mediator public key used by the mediator dispute panel.
# Leave unset in development to fall back to the placeholder key.
# In production this MUST be set to a real mediator public key.
NEXT_PUBLIC_MEDIATOR_PUBLIC_KEY=

# Default fiat issuer for asset helpers.
# Leave unset in development to fall back to the placeholder issuer.
# In production this MUST be set to a real issuer account.
NEXT_PUBLIC_DEFAULT_ISSUER=
