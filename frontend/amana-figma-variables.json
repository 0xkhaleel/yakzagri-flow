      "$description": "Alias of surface-0 (legacy name kept for existing utilities)"
    },
    "bg-card": {
      "$type": "color",
      "$value": {
        "light": "{surface-1}",
        "dark": "{surface-1}"
      },
      "$description": "Alias of surface-1 (legacy name kept for existing utilities)"
    },
    "bg-elevated": {
      "$type": "color",
      "$value": {
        "light": "{surface-2}",
        "dark": "{surface-2}"
      },
      "$description": "Alias of surface-2 (legacy name kept for existing utilities)"
    },
    "bg-overlay": {
      "$type": "color",
      "$value": {
        "light": "{surface-3}",
        "dark": "{surface-3}"
      },
      "$description": "Alias of surface-3 (legacy name kept for existing utilities)"
