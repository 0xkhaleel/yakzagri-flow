{
  "$description": "Figma variables export. One mode per theme, mirroring frontend/design-tokens.json and the custom properties in src/app/globals.css. Regenerate with `node scripts/design-tokens.mjs --write`; CI runs `--check` and fails if this file is stale.",
  "amana-colors": {
    "surface-0": {
      "$type": "color",
      "$value": {
        "light": "#F7FAF8",
        "dark": "#0B1A14"
      },
      "$description": "Page canvas — deepest background"
    },
    "surface-1": {
      "$type": "color",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#122A1F"
      },
      "$description": "Card / panel surface"
    },
    "surface-2": {
      "$type": "color",
      "$value": {
        "light": "#F0F5F1",
        "dark": "#1A3D2C"
      },
      "$description": "Elevated surface — active rows, modals, dropdowns"
    },
    "surface-3": {
      "$type": "color",
      "$value": {
        "light": "rgba(0, 0, 0, 0.4)",
        "dark": "rgba(11, 26, 20, 0.85)"
      },
      "$description": "Overlay / modal scrim"
    },
    "gold": {
      "$type": "color",
      "$value": {
        "light": "#9A7B2F",
        "dark": "#D4A853"
      },
      "$description": "Primary CTA, locked funds, highlights"
    },
    "gold-hover": {
      "$type": "color",
      "$value": {
        "light": "#8A6B20",
        "dark": "#E0BA6A"
      },
      "$description": "Gold hover state"
    },
    "gold-muted": {
      "$type": "color",
      "$value": {
        "light": "rgba(154, 123, 47, 0.1)",
        "dark": "rgba(212, 168, 83, 0.15)"
      },
      "$description": "Gold tinted backgrounds"
    },
    "emerald": {
      "$type": "color",
      "$value": {
        "light": "#059669",
        "dark": "#34D399"
      },
      "$description": "Success, verified, delivered"
    },
    "emerald-muted": {
      "$type": "color",
      "$value": {
        "light": "rgba(5, 150, 105, 0.1)",
        "dark": "rgba(52, 211, 153, 0.15)"
