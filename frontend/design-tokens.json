{
  "$schema": "https://design-tokens.org/format/2024",
  "$description": "Canonical design tokens for the Amana frontend. Every value in `themes` is the exact value of the matching custom property in `src/app/globals.css` (`:root` = light, `.dark` = dark); `colors` restates each token with both modes. Regenerate with `node scripts/design-tokens.mjs --write` — CI runs `--check` and fails if this file and globals.css disagree.",
  "themes": {
    "light": {
      "--surface-0": "#F7FAF8",
      "--surface-1": "#FFFFFF",
      "--surface-2": "#F0F5F1",
      "--surface-3": "rgba(0, 0, 0, 0.4)",
      "--gold": "#9A7B2F",
      "--gold-hover": "#8A6B20",
      "--gold-muted": "rgba(154, 123, 47, 0.1)",
      "--emerald": "#059669",
      "--emerald-muted": "rgba(5, 150, 105, 0.1)",
      "--text-primary": "#1A2E1F",
      "--text-secondary": "#4A6B52",
      "--text-muted": "#7A9A82",
      "--text-inverse": "#FFFFFF",
      "--status-success": "#059669",
      "--status-warning": "#D97706",
      "--status-danger": "#DC2626",
      "--status-info": "#2563EB",
      "--status-locked": "#9A7B2F",
      "--status-draft": "#6B7280",
      "--border-subtle": "rgba(26, 46, 31, 0.08)",
      "--border-default": "rgba(26, 46, 31, 0.15)",
      "--border-raised": "rgba(26, 46, 31, 0.22)",
      "--border-hover": "rgba(26, 46, 31, 0.3)",
      "--border-focus": "rgba(154, 123, 47, 0.5)",
      "--shadow-elev-1": "0 1px 4px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04)",
      "--shadow-elev-2": "0 4px 12px rgba(0,0,0,0.08), 0 8px 24px rgba(0,0,0,0.06)",
      "--shadow-elev-3": "0 16px 48px rgba(0,0,0,0.1)",
      "--bg-input": "#EBF0ED",
      "--skeleton-base": "#E8EDE9",
      "--skeleton-sheen": "rgba(26, 46, 31, 0.06)",
      "--scrollbar-track": "#F0F5F1",
      "--scrollbar-thumb": "rgba(26, 46, 31, 0.15)",
      "--scrollbar-thumb-hover": "rgba(26, 46, 31, 0.25)",
      "--bg-primary": "var(--surface-0)",
      "--bg-card": "var(--surface-1)",
      "--bg-elevated": "var(--surface-2)",
      "--bg-overlay": "var(--surface-3)"
    },
    "dark": {
      "--surface-0": "#0B1A14",
      "--surface-1": "#122A1F",
      "--surface-2": "#1A3D2C",
      "--surface-3": "rgba(11, 26, 20, 0.85)",
      "--gold": "#D4A853",
      "--gold-hover": "#E0BA6A",
      "--gold-muted": "rgba(212, 168, 83, 0.15)",
      "--emerald": "#34D399",
      "--emerald-muted": "rgba(52, 211, 153, 0.15)",
      "--text-primary": "#F0F5F1",
      "--text-secondary": "#8BA89A",
      "--text-muted": "#5A7A6A",
      "--text-inverse": "#0B1A14",
      "--status-success": "#34D399",
      "--status-warning": "#F59E0B",
      "--status-danger": "#EF4444",
      "--status-info": "#3B82F6",
      "--status-locked": "#D4A853",
      "--status-draft": "#6B7280",
      "--border-subtle": "rgba(139, 168, 154, 0.12)",
      "--border-default": "rgba(139, 168, 154, 0.2)",
      "--border-raised": "rgba(139, 168, 154, 0.32)",
      "--border-hover": "rgba(139, 168, 154, 0.4)",
      "--border-focus": "rgba(212, 168, 83, 0.6)",
      "--shadow-elev-1": "0 1px 4px rgba(0,0,0,0.25), 0 4px 24px rgba(0,0,0,0.3)",
      "--shadow-elev-2": "0 4px 12px rgba(0,0,0,0.35), 0 8px 32px rgba(0,0,0,0.4)",
      "--shadow-elev-3": "0 16px 48px rgba(0,0,0,0.5)",
      "--bg-input": "#0F2219",
      "--skeleton-base": "#1A3D2C",
      "--skeleton-sheen": "rgba(240, 245, 241, 0.08)",
      "--scrollbar-track": "#0B1A14",
      "--scrollbar-thumb": "rgba(139, 168, 154, 0.2)",
      "--scrollbar-thumb-hover": "rgba(139, 168, 154, 0.4)",
      "--bg-primary": "var(--surface-0)",
      "--bg-card": "var(--surface-1)",
      "--bg-elevated": "var(--surface-2)",
      "--bg-overlay": "var(--surface-3)"
    }
  },
  "colors": {
